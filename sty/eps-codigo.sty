%% =============================================================================
%% ENTRADA EN EL ÍNDICE DE CÓDIGOS
%% =============================================================================
%% Los entornos por lenguaje usan como título y entrada del índice la
%% etiqueta del lenguaje (p. ej. «Python»). Si el usuario indica su propio
%% title={...}, la entrada del índice pasa a ser ese título (salvo que también
%% indique list entry={...}).
\tcbset{
  % #1: título por defecto, #2: texto por defecto de la entrada del índice
  eps-code-defaults/.code 2 args={%
    \tcbset{title={#1},list entry={\protect\numberline{\thelisting}#2}}%
    \let\eps@code@titulo\kvtcb@title
    \let\eps@code@entrada\kvtcb@listentry
  },
  eps-code-entry-from-title/.code={%
    \ifx\kvtcb@title\eps@code@titulo\else
      \ifx\kvtcb@listentry\eps@code@entrada
        % Misma forma que la entrada por defecto, con el título del usuario
        \begingroup
        \edef\eps@tempa{\endgroup
          \noexpand\tcbset{list entry={%
            \noexpand\protect\noexpand\numberline{\noexpand\thelisting}%
            \unexpanded\expandafter{\kvtcb@title}}}}%
        \eps@tempa
      \fi
    \fi
  },
}

%% Entorno Genérico Simple
%% Uso: \begin{codigosimple}[opciones extra]{lenguaje}{Titulo}
\newtcblisting[use counter=listing, list inside=lol, list type=listing]{codigosimple}[3][]{simple-linenos,minted language=#2,title={#3},list entry={\protect\numberline{\thelisting}#3},#1}
\newtcblisting[use counter=listing, list inside=lol, list type=listing]{codigosimpleNN}[3][]{simple-nolinenos,minted language=#2,title={#3},list entry={\protect\numberline{\thelisting}#3},#1}

%% =============================================================================
%% ENTORNOS POR LENGUAJE
%% =============================================================================
%% Cada lenguaje define cuatro entornos con la misma firma [opciones]:
%%   <nombre>code        VS Code claro con números de línea
%%   <nombre>codeNN      VS Code claro sin números de línea
%%   <nombre>codeDark    VS Code oscuro con números de línea
%%   <nombre>codeDarkNN  VS Code oscuro sin números de línea
%% Las opciones son claves de tcolorbox (title=..., minted options={...}, ...).

%% Define un entorno de código.
%% #1: nombre del entorno, #2: estilo, #3: lenguaje minted, #4: icono, #5: etiqueta
%% El argumento opcional se declara como `!O{}': solo se reconoce si el '['
%% va pegado a \begin{...}. Así nunca se inspecciona la primera línea del
%% código (con [1][] una primera línea como '#include <x>' o '#!/bin/bash'
%% provocaba «Illegal parameter number in definition of \next»).
\newcommand\eps@definircodigo[5]{%
  \DeclareTCBListing[use counter=listing, list inside=lol, list type=listing]{#1}{ !O{} }{%
    #2,minted language=#3,%
    eps-code-defaults={\faIcon{#4}~~#5}{#5},%
    ##1,%
    eps-code-entry-from-title%
  }%
}

%% Declara las cuatro variantes de un lenguaje.
%% \eps@lenguaje{prefijo}{lenguaje minted}{icono}{etiqueta}
\newcommand\eps@lenguaje[4]{%
  \eps@definircodigo{#1code}{vscode-light-linenos}{#2}{#3}{#4}%
  \eps@definircodigo{#1codeNN}{vscode-light-nolinenos}{#2}{#3}{#4}%
  \eps@definircodigo{#1codeDark}{vscode-dark-linenos}{#2}{#3}{#4}%
  \eps@definircodigo{#1codeDarkNN}{vscode-dark-nolinenos}{#2}{#3}{#4}%
}

