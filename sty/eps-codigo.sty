%% NOTA IMPORTANTE:
%% Este paquete depende de 'minted', que a su vez requiere Python y Pygments instalado.
%% Es OBLIGATORIO compilar con la opción -shell-escape habilitada.
%% Ejemplo: lualatex -shell-escape main.tex

%% Cargar paquetes necesarios
\RequirePackage{tcolorbox}
\tcbuselibrary{minted,skins,breakable,theorems}
\RequirePackage{minted}
\RequirePackage{fontawesome5}

%% Selector de textos según el idioma del documento (lo define la clase;
%% si no existe, se usan los textos en español).
%% Uso: \EPSsegunidioma{español}{valenciano}{inglés}
\providecommand\EPSsegunidioma[3]{#1}

%% Nombres de minted/listings según el idioma del documento
\renewcommand{\listoflistingscaption}{%
  \EPSsegunidioma{Índice de Códigos}{Índex de Codis}{List of Listings}}
\renewcommand{\listingscaption}{\EPSsegunidioma{Código}{Codi}{Listing}}

%% Numerar listings por capítulo (igual que figuras y tablas)
\AtBeginDocument{%
  \@ifundefined{c@chapter}{}{%
    \counterwithin{listing}{chapter}%
  }%
}

%% Definir comando para índice de códigos
\newcommand{\indiceCodigos}{\listoflistings}

