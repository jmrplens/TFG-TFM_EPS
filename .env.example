# ==============================================================================
# Configuración opcional — Plantilla TFG/TFM EPS UA
# ==============================================================================
#
# Este archivo es una PLANTILLA. Para usarlo:
#
#   1. Copia este archivo con el nombre  .env  (sin ".example")
#      En terminal:  cp .env.example .env
#      En Windows:   copy .env.example .env
#
#   2. Rellena los valores de las claves que quieras activar.
#      Las claves vacías (sin valor) se ignoran.
#
#   3. El archivo .env NO se sube a GitHub porque está en .gitignore.
#      Tus credenciales permanecen solo en tu ordenador.
#
#   4. Tener claves aquí NO envía nada por sí solo. El texto del trabajo solo
#      se manda a Copyleaks/Turnitin si lo pides explícitamente y confirmas:
#        python3 scripts/revision-rapida.py --plagio copyleaks
#        python3 scripts/revision-rapida.py --plagio turnitin
#        python3 scripts/revision-rapida.py --plagio todos
#      (añade --si para confirmar sin preguntar, p.ej. en un script)
#
# ==============================================================================


# ------------------------------------------------------------------------------
# COPYLEAKS — Detección de plagio y contenido generado por IA (opcional)
# ------------------------------------------------------------------------------
# Para qué sirve:
#   Con --plagio copyleaks, envía el texto de tu documento a Copyleaks para
#   buscar indicios de plagio o de texto generado automáticamente por IA.
#   Cada envío consume créditos de tu cuenta (salvo en modo sandbox).
#
# Cómo obtener la clave (gratuito con cuenta básica):
#   1. Regístrate en https://copyleaks.com
#   2. Inicia sesión y ve a "Settings" → "API Access"
#   3. Copia tu email de cuenta y tu clave de API (UUID)
#
# Formato: tu-email@dominio.com:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Ejemplo: alumno@alu.ua.es:12345678-abcd-efgh-ijkl-000000000000
#
COPYLEAKS_API_KEY=
#
# URL de aviso (webhook) — OBLIGATORIA para Copyleaks:
#   La API de Copyleaks es asíncrona y exige una URL https:// a la que enviará
#   los avisos de estado del análisis. Debe ser un servidor que TÚ controles
#   (no uses servicios públicos de terceros). {STATUS} se sustituye por el
#   estado del análisis. Los resultados se consultan en https://app.copyleaks.com
# Ejemplo: https://mi-servidor.example/copyleaks/{STATUS}
COPYLEAKS_WEBHOOK_URL=
#
# Modo de pruebas (sandbox): true para probar la integración sin consumir
# créditos (Copyleaks devuelve resultados simulados).
COPYLEAKS_SANDBOX=


# ------------------------------------------------------------------------------
# TURNITIN — Detección de plagio con acceso institucional (opcional)
# ------------------------------------------------------------------------------
# Con --plagio turnitin, crea una NUEVA entrega en Turnitin en cada envío y
# muestra el porcentaje de similitud en el informe.
# ATENCIÓN: Turnitin requiere que tu universidad tenga contrato.
# Si no sabes si tu universidad lo tiene, pregunta en tu biblioteca.
#
# Clave de API (te la proporciona el servicio de tu institución):
TURNITIN_API_KEY=
#
# URL de tu institución en Turnitin:
# Ejemplo: https://ua.turnitin.com/api/v1
TURNITIN_TENANT_URL=
